# Phase 1A does not read any environment variables yet.
# This file exists so later phases (1B: Postgres/auth, Redis, etc.)
# have a documented place to add settings, e.g.:
#
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jarvis
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET_KEY=change-me
# ENVIRONMENT=development
